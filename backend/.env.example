# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# Port the HTTP server listens on.
PORT=4000

# OCR backend to use. One of: "google" | "mock"
#   google — Google Cloud Vision (needs credentials below)
#   mock   — returns MOCK_OCR_TEXT; no cloud/credentials needed (local dev/tests)
OCR_PROVIDER=google

# --- Google Vision auth: set ONE of the three below ---

# 1) Vision API key (the "AIza..." key from the GCP console).
GOOGLE_VISION_API_KEY=your-vision-api-key-here

# 2) OR path to a downloaded service-account JSON key. The @google-cloud/vision
#    client reads this automatically. Preferred for local dev.
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# 3) OR the entire service-account JSON inline, as a single line. For cloud
#    hosts (Render, etc.) where uploading a key file is awkward — the app writes
#    it to a temp file at startup. Leave this UNSET locally (use option 2).
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}

# Text the mock OCR provider "reads" from any image (only used when
# OCR_PROVIDER=mock). Handy for exercising the verify pipeline offline.
# MOCK_OCR_TEXT=RSN:RKBBPFM7C000167

# Database connection string (used later — placeholder for now).
DATABASE_URL=postgres://user:password@localhost:5432/labelverify

# --- Supabase (image archive + scan audit log) ---
# Leave UNSET to disable persistence — /api/verify still works but returns
# imageUrl=null, and /api/scans + /api/stats return 503.
#
#   SUPABASE_URL           — your project URL: https://<ref>.supabase.co
#   SUPABASE_SERVICE_KEY   — the service_role key (Project settings → API).
#                            NEVER expose this to the frontend.
#   SUPABASE_STORAGE_BUCKET — bucket to write into (default: "label-scans").
#                             Create it as PUBLIC if you want the returned URLs
#                             to be shareable without a signed link.
#
# BEFORE FIRST RUN, apply the SQL migration in `db/001_init_scans.sql` on the
# same Supabase project. Without it, /api/verify inserts will fail (logged as
# errors, verification response is unaffected) and /api/scans returns empty.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=label-scans

# Comma-separated list of allowed CORS origins.
# Leave UNSET to allow all origins ("*") — dev-friendly. Set to lock down.
# Example for local Expo dev + web:
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
