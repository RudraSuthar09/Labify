{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_BASE_URL": "https://labify-nl4m.onrender.com",
        "OCR_PROVIDER": "google-vision"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "API_BASE_URL": "https://labify-nl4m.onrender.com",
        "OCR_PROVIDER": "google-vision"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
