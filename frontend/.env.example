# Copy this file to `.env` and fill in real values.
# These are read at build time by react-native-dotenv and exposed via
# `process.env.<NAME>` and `src/config/env.ts`.

# Base URL of the backend / OCR verification API.
API_BASE_URL=https://api.example.com

# Which OCR provider the app talks to. e.g. "google-vision" | "aws-textract" | "mock"
OCR_PROVIDER=mock
