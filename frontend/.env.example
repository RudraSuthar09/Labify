# Copy this file to `.env` and fill in real values.
# These are read at build time by react-native-dotenv and exposed via
# `process.env.<NAME>` and `src/config/env.ts`.

# Base URL of the backend / OCR verification API. No trailing slash.
# The deployed backend lives on Render, e.g.:
API_BASE_URL=https://labify-nl4m.onrender.com

# Which OCR provider the backend uses. Informational for the app.
# e.g. "google-vision" | "aws-textract" | "mock"
OCR_PROVIDER=google-vision
